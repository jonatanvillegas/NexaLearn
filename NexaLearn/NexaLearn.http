  "userId": "usuario-de-prueba",
  "cursoId": {{cursoId}},
  "estado": "PENDIENTE"
}

###

PUT {{NexaLearn_HostAddress}}/api/inscripciones/{{inscripcionId}}
Content-Type: application/json

{
  "userId": "usuario-de-prueba",
  "cursoId": {{cursoId}},
  "estado": "ACTIVA"
}

###

DELETE {{NexaLearn_HostAddress}}/api/inscripciones/{{inscripcionId}}

###

