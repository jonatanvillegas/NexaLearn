@NexaLearn_HostAddress = http://localhost:5025
@token = pega_aqui_el_token_del_login

### Registrar: crea un usuario con el rol Cliente.

POST {{NexaLearn_HostAddress}}/api/auth/registro
Content-Type: application/json

{
  "nombre": "Cliente",
  "apellido": "Ejemplo",
  "email": "cliente@ejemplo.com",
  "password": "cliente123"
}

###

POST {{NexaLearn_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@ejemplo.com",
  "password": "Admin123"
}

###

### Cliente: crear una orden de PayPal. Abre approvalUrl en el navegador.

POST {{NexaLearn_HostAddress}}/api/pagos/crear-orden
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cursoId": 1
}

### Cliente: capturar la orden después de aprobarla en PayPal.

POST {{NexaLearn_HostAddress}}/api/pagos/capturar-orden
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "orderId": "PEGA_AQUI_EL_ORDER_ID"
}

### Cliente: ver mis compras.

GET {{NexaLearn_HostAddress}}/api/pagos/mis-compras
Authorization: Bearer {{token}}

###

GET {{NexaLearn_HostAddress}}/api/auth/actual
Authorization: Bearer {{token}}

### Solo Admin: reemplaza {userId} por el valor recibido al registrar.

PUT {{NexaLearn_HostAddress}}/api/auth/usuarios/{userId}/rol
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": "Admin"
}

###

GET {{NexaLearn_HostAddress}}/weatherforecast/
Accept: application/json

###

GET {{NexaLearn_HostAddress}}/openapi/v1.json
Accept: application/json

###

GET {{NexaLearn_HostAddress}}/api/categorias
Accept: application/json

###

@categoriaId = 1
GET {{NexaLearn_HostAddress}}/api/categorias/{{categoriaId}}
Accept: application/json

###

POST {{NexaLearn_HostAddress}}/api/categorias
Content-Type: application/json

{
  "nombre": "Programación",
  "descripcion": "Cursos de desarrollo de software",
  "estado": true
}

###

PUT {{NexaLearn_HostAddress}}/api/categorias/{{categoriaId}}
Content-Type: application/json

{
  "nombre": "Desarrollo de software",
  "descripcion": "Categoría actualizada",
  "estado": true
}

###

DELETE {{NexaLearn_HostAddress}}/api/categorias/{{categoriaId}}

###

@cursoId = 1
@leccionId = 1
@inscripcionId = 1
@pagoId = 1
@perfilId = 1
@cursoImagenId = 1

GET {{NexaLearn_HostAddress}}/api/cursos

###

GET {{NexaLearn_HostAddress}}/api/cursos/{{cursoId}}

### Crear curso sin imagen. La categoría debe existir.

POST {{NexaLearn_HostAddress}}/api/cursos
Content-Type: multipart/form-data; boundary=NexaLearnBoundary

--NexaLearnBoundary
Content-Disposition: form-data; name="CategoriaId"

{{categoriaId}}
--NexaLearnBoundary
Content-Disposition: form-data; name="Titulo"

Curso de C#
--NexaLearnBoundary
Content-Disposition: form-data; name="Precio"

25
--NexaLearnBoundary
Content-Disposition: form-data; name="Estado"

true
--NexaLearnBoundary--

### Actualizar sin imagen conserva la existente.

PUT {{NexaLearn_HostAddress}}/api/cursos/{{cursoId}}
Content-Type: multipart/form-data; boundary=NexaLearnBoundary

--NexaLearnBoundary
Content-Disposition: form-data; name="CategoriaId"

{{categoriaId}}
--NexaLearnBoundary
Content-Disposition: form-data; name="Titulo"

Curso actualizado
--NexaLearnBoundary
Content-Disposition: form-data; name="Precio"

30
--NexaLearnBoundary
Content-Disposition: form-data; name="Estado"

true
--NexaLearnBoundary--

### Para adjuntar/reemplazar una imagen utiliza el selector de archivos de Swagger.

GET {{NexaLearn_HostAddress}}/api/cursos/{{cursoId}}/imagen

###

DELETE {{NexaLearn_HostAddress}}/api/cursos/{{cursoId}}

###

GET {{NexaLearn_HostAddress}}/api/lecciones

###

GET {{NexaLearn_HostAddress}}/api/lecciones/{{leccionId}}

###

POST {{NexaLearn_HostAddress}}/api/lecciones
Content-Type: application/json

{
  "cursoId": {{cursoId}},
  "titulo": "Introducción",
  "descripcion": "Primera lección",
  "contenido": "Contenido de la lección",
  "orden": 1,
  "estado": true
}

###

PUT {{NexaLearn_HostAddress}}/api/lecciones/{{leccionId}}
Content-Type: application/json

{
  "cursoId": {{cursoId}},
  "titulo": "Introducción actualizada",
  "orden": 1,
  "estado": true
}

###

DELETE {{NexaLearn_HostAddress}}/api/lecciones/{{leccionId}}

